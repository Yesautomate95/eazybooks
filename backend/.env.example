# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=ap-south-1

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=aureus

# Database
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# JWT
JWT_SECRET=your_jwt_secret_here

# Tavily
TAVILY_API_KEY=your_tavily_api_key

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key

# Google
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_API_KEY=your_google_api_key
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# Kite
KITE_API_KEY=your_kite_api_key
KITE_SECRET_KEY=your_kite_secret_key

# Other APIs
STOCK_NEWS_API_KEY=your_stock_news_api_key
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
DEEPSEEK_API_KEY=your_deepseek_api_key

# Reddit
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=your_reddit_user_agent

# News API
NEWS_API_KEY=your_news_api_key

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# App
APP_ENV=development

# QuickBooks (mode switch + URLs)
# QB_MODE=qbo for QuickBooks Online (OAuth2/REST), 'desktop' for Desktop via Electron bridge
QB_MODE=qbo
QB_URL=http://localhost:9001

# QuickBooks Online (sandbox by default)
QBO_CLIENT_ID=your_qbo_client_id
QBO_CLIENT_SECRET=your_qbo_client_secret
QBO_REDIRECT_URI=http://localhost:8000/ca/qb/oauth/callback
QBO_ENV=sandbox
QBO_FRONTEND_RETURN_URL=http://localhost:3000/dashboard/qb

# Zoho Books (OAuth2 / REST)
# ZOHO_DC selects the data center: com | in | eu | com.au | jp | ca | sa
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=http://localhost:8000/ca/zoho/oauth/callback
ZOHO_DC=com
ZOHO_SCOPES=ZohoBooks.fullaccess.all
ZOHO_FRONTEND_RETURN_URL=http://localhost:3000/dashboard/zoho

# Xero (OAuth2 / REST)
XERO_CLIENT_ID=your_xero_client_id
XERO_CLIENT_SECRET=your_xero_client_secret
XERO_REDIRECT_URI=http://localhost:8000/ca/xero/oauth/callback
XERO_SCOPES=openid profile email accounting.transactions accounting.contacts accounting.settings accounting.reports.read offline_access
XERO_FRONTEND_RETURN_URL=http://localhost:3000/dashboard/xero

# SAP S/4HANA Cloud (OAuth2 + OData)
# client_credentials is the default for a BTP communication arrangement.
SAP_AUTH_MODE=client_credentials
SAP_CLIENT_ID=your_sap_client_id
SAP_CLIENT_SECRET=your_sap_client_secret
SAP_TOKEN_URL=https://your-subaccount.authentication.<region>.hana.ondemand.com/oauth/token
SAP_API_BASE=https://your-tenant.s4hana.cloud.sap/sap/opu/odata/sap
SAP_DEFAULT_COMPANY_CODE=1000

# Use these instead for browser consent / authorization_code mode.
# SAP_AUTH_MODE=authorization_code
# SAP_AUTHORIZE_URL=https://your-subaccount.authentication.<region>.hana.ondemand.com/oauth/authorize
# SAP_REDIRECT_URI=http://localhost:8000/ca/sap/oauth/callback
# SAP_SCOPES=openid
# SAP_FRONTEND_RETURN_URL=http://localhost:3000/dashboard/sap
