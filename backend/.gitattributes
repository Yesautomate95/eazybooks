# Normalize line endings: auto-detect text files and store/checkout as LF.
# Kills spurious CRLF diffs when the repo is edited on Windows.
* text=auto eol=lf

# Windows scripts must keep CRLF to run correctly
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.gz binary
*.mp4 binary
*.keystore binary
