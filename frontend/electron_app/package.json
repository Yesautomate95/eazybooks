{
  "name": "eazybooks-desktop",
  "version": "1.0.12",
  "description": "EazyBooks Desktop Application",
  "main": "src/main/electron.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare:loader": "npm install --omit=dev --prefix tally-loader",
    "build": "npm run prepare:loader && electron-builder build --win",
    "build:dir": "npm run prepare:loader && electron-builder build --win --dir",
    "pack": "npm run prepare:loader && electron-builder --dir",
    "dist": "npm run prepare:loader && electron-builder"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "dotenv": "^16.0.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.6.2",
    "firebase": "^11.6.0",
    "firebase-admin": "^13.2.0",
    "js-yaml": "^4.1.0",
    "odbc": "^2.4.9",
    "pg": "^8.13.0",
    "pg-copy-streams": "^6.0.6",
    "ws": "^8.18.1",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.eazybooks.app",
    "productName": "EazyBooks",
    "copyright": "Copyright © 2025 EazyBooks",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json",
      ".env"
    ],
    "extraResources": [
      {
        "from": "node_modules/odbc/build/Release/",
        "to": "odbc",
        "filter": [
          "*.node"
        ]
      },
      {
        "from": "tally-loader",
        "to": "tally-loader"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/assets/icon.ico",
      "artifactName": "EazyBooks-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://pub-5d6be9a7b1324f2c99df92a72a3b216c.r2.dev/desktop/",
        "channel": "latest"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EazyBooks",
      "perMachine": true,
      "installerIcon": "public/assets/icon.ico",
      "uninstallerIcon": "public/assets/icon.ico",
      "installerHeaderIcon": "public/assets/icon.ico",
      "menuCategory": "EazyBooks"
    },
    "protocols": {
      "name": "eazybooks",
      "schemes": [
        "eazybooks"
      ]
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/odbc/**/*"
    ]
  },
  "author": {
    "name": "EazyBooks",
    "email": "support@eazybooks.ai"
  },
  "license": "UNLICENSED",
  "private": true
}
